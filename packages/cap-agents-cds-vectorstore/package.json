{
  "name": "@mi8y/cap-agents-cds-vectorstore",
  "version": "0.2.0",
  "description": "CDS Plugin for building vector retrieval in LangGraph/LangChain/DeepAgents - Vector Store",
  "author": "Merbin J Anselm <merbin.j.anselm@mi8y.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mi8y/cap-agents-plugins.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/mi8y/cap-agents-plugins/tree/main/packages/cap-agents-cds-vectorstore",
  "bugs": {
    "url": "https://github.com/mi8y/cap-agents-plugins/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cds-plugin": "./cds-plugin.js",
    "./index.cds": "./index.cds"
  },
  "files": [
    "dist/**/*",
    "index.cds",
    "cds-plugin.js",
    "lib/",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "sap",
    "cap",
    "cds",
    "agent",
    "langgraph",
    "langchain",
    "deepagents",
    "vectorstore",
    "retrieval"
  ],
  "dependencies": {
    "@mi8y/cap-agents-utils": "workspace:*"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.41.0",
    "@cap-js/cds-types": "^0.19.0",
    "@cap-js/sqlite": "^3.1.0",
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^1.2.9",
    "@sap/cds": ">=10",
    "@sap/eslint-plugin-cds": "^4.2.5",
    "@tsconfig/recommended": "^1.0.13",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "@sap/cds": ">=10",
    "@langchain/core": ">=1"
  },
  "peerDependenciesMeta": {
    "@sap/cds": {
      "optional": false
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && npm run build:cds-types && vite build",
    "build:cds-types": "node ../../scripts/build-cds-types.mjs",
    "test": "vitest run --coverage",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "clean": "shx rm -rf node_modules dist @cds-models tmp .turbo"
  },
  "packageManager": "pnpm@11.11.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "cds": {
    "requires": {
      "cap-agents-cds-vectorstore": {}
    }
  }
}
