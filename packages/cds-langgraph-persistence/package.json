{
  "name": "@mi8y/cds-langgraph-persistence",
  "version": "0.7.0",
  "description": "CDS Plugin for LangGraph checkpoint persistence in SAP CAP applications",
  "author": "Merbin J Anselm <merbin.j.anselm@mi8y.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mi8y/cap-agents-plugins.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/mi8y/cap-agents-plugins",
  "bugs": {
    "url": "https://github.com/mi8y/cap-agents-plugins/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cds-plugin": "./cds-plugin.js",
    "./index.cds": "./index.cds"
  },
  "files": [
    "dist/**/*",
    "index.cds",
    "cds-plugin.js",
    "lib/",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "sap",
    "cap",
    "cds",
    "agent",
    "langgraph",
    "langchain",
    "deepagents",
    "checkpointer",
    "short-term-memory"
  ],
  "dependencies": {
    "@langchain/langgraph-checkpoint": "^1.1.5"
  },
  "devDependencies": {
    "@mi8y/cap-agents-utils": "workspace:*",
    "@cap-js/cds-typer": "^0.41.0",
    "@cap-js/cds-types": "^0.19.0",
    "@cap-js/sqlite": "^3.1.0",
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph-checkpoint-validation": "^1.1.1",
    "@sap/cds": ">=10",
    "@sap/eslint-plugin-cds": "^4.2.5",
    "@tsconfig/recommended": "^1.0.13",
    "@typescript/typescript6": "^6.0.2",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "@sap/cds": ">=10"
  },
  "peerDependenciesMeta": {
    "@sap/cds": {
      "optional": false
    }
  },
  "scripts": {
    "build": "shx rm -rf dist && npm run build:cds-types && vite build",
    "build:cds-types": "node ../../scripts/build-cds-types.mjs",
    "test": "vitest run --coverage",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings 0",
    "clean": "shx rm -rf node_modules dist @cds-models tmp .turbo"
  },
  "packageManager": "pnpm@11.11.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "cds": {
    "requires": {
      "cds-langgraph-persistence": {}
    }
  }
}
