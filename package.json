{
  "name": "@mi8y/cds-agent-plugins",
  "description": "SAP CDS LangGraph Plugins",
  "author": "Merbin J Anselm <merbin.j.anselm@mi8y.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mi8y/cap-agents-addons.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/mi8y/cap-agents-addons",
  "bugs": {
    "url": "https://github.com/mi8y/cap-agents-addons/issues"
  },
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage --project='!integration-tests'",
    "test:integration": "pnpm --filter @mi8y/integration-tests start",
    "lint": "turbo run lint",
    "lint:check": "turbo run lint:check",
    "clean": "turbo run clean && rm -rf node_modules coverage .turbo",
    "format": "prettier --write \"**/*.{json,ts,js,mjs,cjs,md}\"",
    "format:check": "prettier --check \"**/*.{json,ts,js,mjs,cjs,md}\"",
    "changeset": "changeset",
    "release:check": "node scripts/check-release-readiness.mjs",
    "release:check:metadata": "node scripts/check-release-readiness.mjs --metadata-only",
    "version-packages": "changeset version && pnpm install --no-frozen-lockfile && pnpm run format",
    "publish-packages": "pnpm run release:check && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.9.6",
    "shelljs": "^0.10.0",
    "shx": "^0.4.0",
    "turbo": "^2.10.12",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ]
}
